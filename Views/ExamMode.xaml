<Window x:Class="gokao.Views.ExamMode"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gokao"
        mc:Ignorable="d"
        Title="{Binding [Exam Mode], Source={x:Static local:LanguageManager.Instance}}"
        Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding [ExamDesc], Source={x:Static local:LanguageManager.Instance}}"
                       FontSize="18" Foreground="#616161" HorizontalAlignment="Center" Margin="0,0,0,28"/>
            <Button x:Name="examCountdownBtn"
                    Content="{Binding [ExamCountdown], Source={x:Static local:LanguageManager.Instance}}"
                    Click="ExamCountdownBtn_Click" Height="40" MinWidth="150" Padding="16,0" Margin="0,0,0,14"
                    Background="#1976D2" Foreground="White" BorderBrush="#1976D2" Cursor="Hand"/>
            <Button x:Name="examNotesBtn"
                    Content="{Binding [ExamNotes], Source={x:Static local:LanguageManager.Instance}}"
                    Click="ExamNotesBtn_Click" Height="40" MinWidth="150" Padding="16,0"
                    Background="#43A047" Foreground="White" BorderBrush="#43A047" Cursor="Hand"/>
            <Button x:Name="pomodoroBtn"
                    Content="{Binding [Pomodoro], Source={x:Static local:LanguageManager.Instance}}"
                    Click="PomodoroBtn_Click" Height="40" MinWidth="150" Padding="16,0" Margin="0,14,0,0"
                    Background="#8E24AA" Foreground="White" BorderBrush="#8E24AA" Cursor="Hand"/>
            <CheckBox x:Name="dailyQuoteCheck"
                      Content="{Binding [DailyQuote], Source={x:Static local:LanguageManager.Instance}}"
                      FontSize="13" Margin="0,24,0,0" HorizontalAlignment="Center" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
