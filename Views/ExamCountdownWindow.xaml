<Window x:Class="gokao.Views.ExamCountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:gokao"
        Title="{Binding [ExamCountdown], Source={x:Static local:LanguageManager.Instance}}"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize" Topmost="True"
        Background="#000000" ShowInTaskbar="True"
        KeyDown="Window_KeyDown" MouseWheel="Window_MouseWheel"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp" LostMouseCapture="Window_LostMouseCapture"
        Loaded="Window_Loaded" TouchDown="Window_TouchDown" TouchUp="Window_TouchUp">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- 顶部标语：诚信考试，相信自己！ -->
            <TextBlock x:Name="sloganText"
                       Text="{Binding [ExamSlogan], Source={x:Static local:LanguageManager.Instance}}"
                       FontSize="36" Foreground="#E6FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <!-- 中央大号倒计时数字：时:分:秒独立显示，可分别调整 -->
            <StackPanel x:Name="timePanel" Orientation="Horizontal" HorizontalAlignment="Center"
                        TextElement.FontSize="150" TextElement.FontWeight="Bold"
                        TextElement.Foreground="White" TextElement.FontFamily="Segoe UI">
                <TextBlock x:Name="hoursText" Text="02"/>
                <TextBlock Text=":"/>
                <TextBlock x:Name="minutesText" Text="30"/>
                <TextBlock Text=":"/>
                <TextBlock x:Name="secondsText" Text="00"/>
            </StackPanel>

            <!-- 时间到提示（倒计时结束时显示） -->
            <TextBlock x:Name="timeUpText"
                       Text="{Binding [ExamTimeUpFinish], Source={x:Static local:LanguageManager.Instance}}"
                       FontSize="150" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                       Visibility="Collapsed"/>

            <!-- 滚轮设置提示（仅未开始的设置阶段显示） -->
            <TextBlock x:Name="hintText"
                       Text="{Binding [ExamScrollHint], Source={x:Static local:LanguageManager.Instance}}"
                       FontSize="18" Foreground="#66FFFFFF" HorizontalAlignment="Center" Margin="0,18,0,0"/>

            <!-- 下方按钮区（低调不显眼） -->
            <StackPanel x:Name="buttonsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,52,0,0">
                <Button x:Name="startBtn"
                        Content="{Binding [ExamStart], Source={x:Static local:LanguageManager.Instance}}"
                        Click="StartBtn_Click" Width="128" Height="42" FontSize="16"
                        Background="#2B2B2B" Foreground="#D6D6D6" BorderBrush="#3A3A3A" Cursor="Hand" Margin="0,0,16,0"/>
                <Button x:Name="pauseBtn"
                        Content="{Binding [ExamPause], Source={x:Static local:LanguageManager.Instance}}"
                        Click="PauseBtn_Click" Width="128" Height="42" FontSize="16"
                        Background="#2B2B2B" Foreground="#D6D6D6" BorderBrush="#3A3A3A" Cursor="Hand" Margin="0,0,16,0"/>
                <Button x:Name="closeBtn"
                        Content="{Binding [ExamClose], Source={x:Static local:LanguageManager.Instance}}"
                        Click="CloseBtn_Click" Width="128" Height="42" FontSize="16"
                        Background="#2B2B2B" Foreground="#D6D6D6" BorderBrush="#3A3A3A" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>

        <!-- 左下角实时时钟（Grid 直接子级，固定贴左下角，小字不打扰） -->
        <TextBlock x:Name="clockText" Text="00:00:00"
                   FontSize="20" Foreground="#59FFFFFF" FontFamily="Segoe UI"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,18"/>
    </Grid>
</Window>
