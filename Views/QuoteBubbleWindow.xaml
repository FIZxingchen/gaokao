<Window x:Class="gokao.Views.QuoteBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:gokao"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Width="360" SizeToContent="Height" ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Border x:Name="card" CornerRadius="14" Margin="10"
            Background="#F21A1A2E" BorderBrush="#66FFD54F" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" x:Name="titleText"
                       Text="{Binding [DailyQuoteTitle], Source={x:Static local:LanguageManager.Instance}}"
                       FontSize="14" FontWeight="Bold" Foreground="#FFD54F"/>
            <TextBlock Grid.Row="1" x:Name="quoteText" FontSize="16" Foreground="White"
                       TextWrapping="Wrap" MaxWidth="310" Margin="0,10,0,6" LineHeight="26"/>
            <TextBlock Grid.Row="2" x:Name="footerText"
                       Text="{Binding [DailyQuoteFooter], Source={x:Static local:LanguageManager.Instance}}"
                       FontSize="12" Foreground="#AAAAAA" HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</Window>
