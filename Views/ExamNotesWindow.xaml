<Window x:Class="gokao.Views.ExamNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:gokao"
        Title="{Binding [ExamNotesTitle], Source={x:Static local:LanguageManager.Instance}}"
        Height="600" Width="720" WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">
    <Window.Resources>
        <!-- 纯色阴影层（无模糊，避免 DropShadowEffect 导致文字发虚） -->
        <Style x:Key="CardShadowLayer" TargetType="Border">
            <Setter Property="Background" Value="#1A000000"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,2,2,0"/>
        </Style>

        <!-- 圆角按钮（颜色由 Background 传入，悬停/按下透明度变化） -->
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 自绘圆形勾选框：未勾选空心圆角框，勾选后绿色底 + 白色对勾 -->
        <Style x:Key="RoundCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="box" Width="22" Height="22" CornerRadius="6"
                                    BorderBrush="#C4CAD4" BorderThickness="2"
                                    Background="White" VerticalAlignment="Center">
                                <Path x:Name="tick" Data="M 5,11 L 9,15 L 17,6"
                                      Stroke="White" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#43A047"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#43A047"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#66BB6A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 待办列表项：悬停浅灰、选中浅蓝 -->
        <Style x:Key="TodoListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="8" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F6FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E8F0FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── 便签卡片：米黄便签纸风格 ── -->
        <Grid Grid.Row="0">
            <!-- 纯色阴影层（无模糊） -->
            <Border Style="{StaticResource CardShadowLayer}"/>
            <Border Background="#FFF8E1" CornerRadius="12" Padding="16,14"
                    BorderBrush="#F0E2B6" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📝" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding [ExamNoteLabel], Source={x:Static local:LanguageManager.Instance}}"
                               FontSize="15" FontWeight="Bold" Foreground="#8D6E2C" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox x:Name="noteText" Grid.Row="1" Margin="0,10,0,0"
                         Background="#B3FFFFFF" BorderBrush="#E8DCAE" BorderThickness="1"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontSize="14" Foreground="#3E2F0E" CaretBrush="#3E2F0E"
                         VerticalContentAlignment="Top" Padding="10,8"
                         LostFocus="NoteText_LostFocus"/>
            </Grid>
            </Border>
        </Grid>

        <!-- ── 待办卡片：白色圆角卡片 ── -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <!-- 纯色阴影层（无模糊） -->
            <Border Style="{StaticResource CardShadowLayer}"/>
            <Border Background="White" CornerRadius="12" Padding="16,14"
                    BorderBrush="#E4E7EC" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✅" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding [ExamTodoLabel], Source={x:Static local:LanguageManager.Instance}}"
                               FontSize="15" FontWeight="Bold" Foreground="#333333" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 输入行：输入框 + 添加按钮 -->
                <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="True">
                    <Button x:Name="addBtn" DockPanel.Dock="Right" Width="90" Height="44" Margin="10,0,0,0"
                            Content="{Binding [ExamTodoAdd], Source={x:Static local:LanguageManager.Instance}}"
                            Click="AddBtn_Click" Background="#1976D2" Style="{StaticResource RoundButton}"/>
                    <!-- 圆角外观由外层 Border 提供，内层 TextBox 用默认模板（同便签，避免自定义模板导致文字显示异常） -->
                    <Border x:Name="todoInputBox" Height="44" CornerRadius="8"
                            Background="White" BorderBrush="#D8DCE3" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#D8DCE3"/>
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="#1976D2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBox x:Name="todoInput" Background="Transparent" BorderThickness="0"
                                 FontSize="16" Foreground="#212121" CaretBrush="#212121"
                                 Padding="12,0" VerticalContentAlignment="Center"
                                 ToolTip="{Binding [ExamTodoInputHint], Source={x:Static local:LanguageManager.Instance}}"
                                 KeyDown="TodoInput_KeyDown"/>
                    </Border>
                </DockPanel>

                <!-- 待办列表：勾选划线 = 完成 -->
                <ListBox x:Name="todoList" Grid.Row="2" Margin="0,10,0,0"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource TodoListItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center"
                                          IsChecked="{Binding Done}"
                                          Checked="Todo_Checked" Unchecked="Todo_Unchecked"
                                          Style="{StaticResource RoundCheckBox}"/>
                                <TextBlock Text="{Binding Text}" FontSize="14" Margin="2,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#333333"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Done}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    <Setter Property="Foreground" Value="#9AA0A8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 删除选中 -->
                <Button x:Name="deleteBtn" Grid.Row="3" Width="128" Height="44" Margin="0,14,0,0"
                        HorizontalAlignment="Right"
                        Content="{Binding [ExamTodoDelete], Source={x:Static local:LanguageManager.Instance}}"
                        Click="DeleteBtn_Click" Background="#E53935" Style="{StaticResource RoundButton}"/>
            </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
